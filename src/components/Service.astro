---
const { serviceTitle, serviceBeskrivelse, serviceColor, out, kampagne } =
  Astro.props;
import Label from "./Label.astro";
---

<div
  class={out ? "service dim" : "service"}
  style=`border-top: 4px solid ${serviceColor}`
>
  {kampagne && <Label tilbud={kampagne} />}
  <h3>{serviceTitle}</h3>
  <p>{serviceBeskrivelse}</p>
</div>

<style>
  .dim {
    filter: blur(2px) grayscale(1);
  }
  .service {
    position: relative;
    background: white;
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    flex: 1;
    min-width: 300px;
    max-width: 350px;
    text-align: center;
  }

  .service h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #2d3748;
  }

  .service p {
    color: #718096;
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
