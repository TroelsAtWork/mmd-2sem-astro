---
const { tilbud } = Astro.props;
---

<div>
    <h3>Kampagne {tilbud}</h3>
</div>

<style>
    div {
        position: absolute;
        top: 0;
        right: 0;
        rotate: 20deg;
    }
    h3 {
        background-color: yellow;
        padding: 0.8rem;
        border-radius: 10px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }
</style>
